# Copy this file to deploy.env in the project directory.
# Do not put a passphrase here. The passphrase lives only on the server.
# REMOTE_BASE is the install root, for example /srv/u.

DEPLOY_SSH_HOST=
REMOTE_BASE=
# Required for scripts/publish_batch.py; server-side nginx rendering reads PUBLIC_ORIGIN from $REMOTE_BASE/etc/u.env.
PUBLIC_ORIGIN=
U_GATE_PREFIX=u-gate

# Set to 1 only if you separately host Inter / Noto Sans SC woff2 files under /u/fonts/.
U_CUSTOM_FONTS=0

# Account that owns the published files.
INSTALL_USER=www
INSTALL_GROUP=www

# Account that runs the statistics job.
STATS_USER=www
STATS_GROUP=www

# Directory that already includes the two /u nginx files.
NGINX_CONF_DIR=/etc/nginx
NGINX_GROUP=root

# Interpreter used on the server (Python 3.11+ required).
U_PYTHON=python3

# Set to 1 if you want install-release to refuse deploying stats.py when $REMOTE_BASE/etc/legacy-map.json is absent.
REQUIRE_LEGACY_MAP=0

# CI/CD deploy also needs SSH_PRIVATE_KEY and SSH_KNOWN_HOSTS.
# DEPLOY_SSH_HOST there is the real SSH destination, such as deploy@files.example.
